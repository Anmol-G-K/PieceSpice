* PieceSpice Tier 3 SIMPLIS Level-2 charge-table model for irfs7730pbf
* Generated from fitted PWLModelSpec (K=5 Vgs curves, 101 Vds breakpoints)
.SUBCKT irfs7730pbf_PIECESPICE_T3_simplis d g s
* Pins: 1=Drain(d) 2=Gate(g) 3=Source(s)

* --- parasitics ---
RG g gi 1.500000e+00
RD d di 1.000000e-04
RS s ss 1.000000e-04

* --- channel: tanh-knee behavioral source (Curves 1+2) ---
G_CH di ss VALUE = {((0.000000e+00 + 7.952064e-08*((V(gi,ss)-0.000000e+00)+abs((V(gi,ss))-0.000000e+00))/2 + 4.585767e+00*((V(gi,ss)-3.000000e+00)+abs((V(gi,ss))-3.000000e+00))/2 + 2.139075e+02*((V(gi,ss)-4.500000e+00)+abs((V(gi,ss))-4.500000e+00))/2 + 9.957340e+01*((V(gi,ss)-6.000000e+00)+abs((V(gi,ss))-6.000000e+00))/2 + 4.389064e+01*((V(gi,ss)-8.000000e+00)+abs((V(gi,ss))-8.000000e+00))/2)*tanh(V(di,ss)/(8.024546e+00 + 0.000000e+00*((V(gi,ss)-0.000000e+00)+abs((V(gi,ss))-0.000000e+00))/2 + -4.467528e+00*((V(gi,ss)-3.000000e+00)+abs((V(gi,ss))-3.000000e+00))/2 + 4.509336e+00*((V(gi,ss)-4.500000e+00)+abs((V(gi,ss))-4.500000e+00))/2 + 5.481977e-01*((V(gi,ss)-6.000000e+00)+abs((V(gi,ss))-6.000000e+00))/2 + -1.179886e-03*((V(gi,ss)-8.000000e+00)+abs((V(gi,ss))-8.000000e+00))/2)))}

* --- charge-conserving capacitances (Curve 4, plan 2.3) ---
* Output charge Qoss(Vds) as chained delta ramps:
C_QOSS di ss Q = {0.000000e+00 + 2.669412e-09*((V(di,ss)-0.000000e+00)+abs((V(di,ss))-0.000000e+00))/2 + -7.444480e-10*((V(di,ss)-6.460916e-01)+abs((V(di,ss))-6.460916e-01))/2 + -4.173056e-10*((V(di,ss)-1.437352e+00)+abs((V(di,ss))-1.437352e+00))/2 + -3.146086e-10*((V(di,ss)-2.449490e+00)+abs((V(di,ss))-2.449490e+00))/2 + -2.675458e-10*((V(di,ss)-4.174344e+00)+abs((V(di,ss))-4.174344e+00))/2 + -2.176474e-10*((V(di,ss)-7.113787e+00)+abs((V(di,ss))-7.113787e+00))/2 + -1.286782e-10*((V(di,ss)-1.212309e+01)+abs((V(di,ss))-1.212309e+01))/2 + -7.609092e-11*((V(di,ss)-1.582595e+01)+abs((V(di,ss))-1.582595e+01))/2 + -6.676603e-11*((V(di,ss)-2.065980e+01)+abs((V(di,ss))-2.065980e+01))/2 + -6.683803e-11*((V(di,ss)-2.697009e+01)+abs((V(di,ss))-2.697009e+01))/2}
C_ISS gi ss 1.391359e-08
C_RSS gi di 1.335275e-09
* RGS: documented Level-2 gate-source bleed (10 MOhm)
RGS gi ss 1e7

* --- body diode (Curve 6) ---
* body-diode provenance: measured Curve 6 forward (Vsd,Isd) sweep (config/outputs/irfs7730pbf/curve6_body_diode.yaml); bounded least-squares fit of I=IS*(exp((V-I*RS)/(N*Vt))-1) on log10(current), Vt=0.026 V; IS=1.241716e-09 N=1.205 RS=1.141802e-03; RMS log10 error=1.380106e-01 dec (all 50 samples)
.MODEL D_BD_irfs7730pbf_PIECESPICE_T2 D(IS=1.241716e-09 N=1.205 RS=1.141802e-03)
D_BODY ss di D_BD_irfs7730pbf_PIECESPICE_T2

.ENDS irfs7730pbf_PIECESPICE_T3_simplis