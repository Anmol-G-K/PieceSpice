CDS di ss Q={0.000000e+00 + 2.550479e-09*((V(di,ss)-(0.000000e+00))+abs((V(di,ss))-(0.000000e+00)))/2 + -7.057275e-10*((V(di,ss)-(6.460916e-01))+abs((V(di,ss))-(6.460916e-01)))/2 + -3.980030e-10*((V(di,ss)-(1.437352e+00))+abs((V(di,ss))-(1.437352e+00)))/2 + -3.011110e-10*((V(di,ss)-(2.449490e+00))+abs((V(di,ss))-(2.449490e+00)))/2 + -2.566936e-10*((V(di,ss)-(4.174344e+00))+abs((V(di,ss))-(4.174344e+00)))/2 + -2.091909e-10*((V(di,ss)-(7.113787e+00))+abs((V(di,ss))-(7.113787e+00)))/2 + -1.238029e-10*((V(di,ss)-(1.212309e+01))+abs((V(di,ss))-(1.212309e+01)))/2 + -7.324464e-11*((V(di,ss)-(1.582595e+01))+abs((V(di,ss))-(1.582595e+01)))/2 + -6.428150e-11*((V(di,ss)-(2.065980e+01))+abs((V(di,ss))-(2.065980e+01)))/2 + -6.435536e-11*((V(di,ss)-(2.697009e+01))+abs((V(di,ss))-(2.697009e+01)))/2 + -3.540686e-10*((V(di,ss)-(3.800000e+01))+abs((V(di,ss))-(3.800000e+01)))/2}
